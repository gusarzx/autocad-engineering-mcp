# These variables must be passed via the environment or Codex config, not auto-loaded.
ACAD_MCP_BACKEND=mock
# On Windows choose com explicitly; the default backend is com.
# ACAD_MCP_SAVE_ROOT=C:\Users\YourName\Documents\AutoCAD Engineering MCP
ACAD_MCP_PROG_ID=AutoCAD.Application.26
ACAD_MCP_EXPECTED_VERSION=26.0
ACAD_MCP_MAX_BATCH=100
ACAD_MCP_MAX_CHANGE=20
ACAD_MCP_PAGE_SIZE=100
ACAD_MCP_SCAN_LIMIT=10000
# ACAD_MCP_PROFILE=C:\CAD\profile.json

